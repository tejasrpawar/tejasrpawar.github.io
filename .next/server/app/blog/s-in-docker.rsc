rgin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]]],"forbidden":"$undefined","unauthorized":"$undefined"}],["$","$L6",null,{}]]}]}]}]}]}]]}],{"children":["blog",["$","$1","c",{"children":[null,["$","$L7",null,{"Component":"$8","slots":{"children":["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]},"params":{},"promise":"$@9"}]]}],{"children":["s-in-docker",["$","$1","c",{"children":[null,["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","s-in-docker","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":["__PAGE__",["$","$1","c",{"children":[[["$","h1",null,{"children":"The 'S' in docker joke"}],"\n",["$","figure",null,{"children":[["$","img",null,{"src":"/images/s_in_docker.jpeg","alt":"The McMaster Carr website case study","className":"rounded-xl"}],["$","figcaption",null,{"className":"text-center","children":""}]]}],"\n",["$","hr",null,{}],"\n",["$","p",null,{"children":"The other day, I learned about this running joke that the ‘S’ in ‘Docker’ stands for ‘Security’—an impudent way of saying Docker isn’t exactly built with security as its top priority. This was enough to make me ponder about why VMs still exist with the popularity of this ‘lightweight’ container technology."}],"\n",["$","p",null,{"children":"Docker is impressive. Containers share the host system’s kernel, so you don’t need a whole separate operating system for each app. Meaning quicker startup time and lesser resources compared to VMs. And as it’s a common knowledge: it solved this riotous ‘iT wORkS oN mY mAChinE’ problem."}],"\n",["$","p",null,{"children":"Why aren’t VMs obsolete then? They aren’t. And for good reasons. And the first line of this post answers it. It provides complete isolation(a double-edged sword?).This is key when one needs strong security boundaries. And one must not forget about legacy applications that were designed for specific operating systems—VMs let businesses keep these 'old-but-gold' systems running without a hitch. Docker containers on the other hand share the host system's kernel, meaning if a container exploits a vulnerability in the kernel, it can potentially access the entire host system"}],"\n",["$","p",null,{"children":"Take my situation for example: I’m currently using a Mac, and there are times when I need to run Windows-specific applications. Since macOS doesn’t natively support Windows applications, I must fire up a VM to run Windows on my Mac."}],"\n",["$","p",null,{"children":"It is very obvious for the reasons stated above, many organizations use a mix of both Docker containers and VMs to cover all their bases. Containers are awesome. They are great for microservices and apps that need to scale quickly, while VMs handle tasks that require a full OS environment or extra isolation."}],"\n",["$","p",null,{"children":"This joke was a fun detour. Despite the reputation(or my opinion) of VMs being this bulky old tech, they still are relevant and useful."}]],null,["$","$La",null,{"children":"$Lb"}]]}],{},null,false]},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","S_VD6XR1ccXVIMoVcjQ4D",{"children":[["$","$Lc",null,{"children":"$Ld"}],["$","$Le",null,{"children":"$Lf"}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]]}],false]],"m":"$undefined","G":["$10","$undefined"],"s":false,"S":true}
