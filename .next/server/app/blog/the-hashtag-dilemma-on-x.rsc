isplay":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]]],"forbidden":"$undefined","unauthorized":"$undefined"}],["$","$L6",null,{}]]}]}]}]}]}]]}],{"children":["blog",["$","$1","c",{"children":[null,["$","$L7",null,{"Component":"$8","slots":{"children":["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]},"params":{},"promise":"$@9"}]]}],{"children":["the-hashtag-dilemma-on-x",["$","$1","c",{"children":[null,["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","the-hashtag-dilemma-on-x","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":["__PAGE__",["$","$1","c",{"children":[[["$","h1",null,{"children":"The Hashtag Dilemma on X"}],"\n",["$","figure",null,{"children":[["$","img",null,{"src":"/images/x_elon.jpeg","alt":"Design and AI intersection illustration","className":"rounded-xl"}],["$","figcaption",null,{"className":"text-center","children":""}]]}],"\n",["$","hr",null,{}],"\n",["$","p",null,{"children":"Elon Musk has repeatedly come against the usage of hashtags on X. The screenshot attached is one of the instances(yes, I am a light mode supremacist); and it does feel counterintuitive and contradictory, given they were popularized by the same app. While X has gone tremendous change over time, this is quite intriguing a scenario."}],"\n",["$","p",null,{"children":"As for me, hashtags have always been aesthetically unpleasant. Clean and straightforward content >> emoji and hashtag filled jargon."}],"\n",["$","p",null,{"children":"It is a common belief(and it is indeed true) that hashtags are powerful for grouping similar content together and making it easier on users and they increase engagement by making a post(Xeet?) more visible. But GrokAI has a different opinion citing the algorithm promotes content based on relevance, user engagement and context rather than relying on hashtags."}],"\n",["$","p",null,{"children":"While hashtags can still be useful for niche communities or specific campaigns, they are not as vital as they used to be, in my opinion. This shows in the way the ‘What’s happening’ tab features content where I see lesser hashtags and more ‘words/trends’.\nAlthough the same argument cannot be made against other platforms in existence including this, it is worth questioning the amendments and how something can disseminate down over a period of time(will it?)."}],"\n",["$","p",null,{"children":"It is indeed a topic to ponder upon, and dive into the algorithmic changes that made such a shift."}],"\n",["$","p",null,{"children":"“a desperate cry into the void” is what grok has to say about hashtags!"}]],null,["$","$La",null,{"children":"$Lb"}]]}],{},null,false]},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","bXQk2M3p2llarM4MoIJs1",{"children":[["$","$Lc",null,{"children":"$Ld"}],["$","$Le",null,{"children":"$Lf"}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]]}],false]],"m":"$undefined","G":["$10","$undefined"],"s":false,"S":true}
